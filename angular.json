{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sistema-core-front": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [{ "glob": "**/*", "input": "public" }],
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 4250, "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "sistema-core-front:build:production" },
            "development": { "buildTarget": "sistema-core-front:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
